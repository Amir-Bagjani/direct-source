NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
DJANGO_API_URL=http://127.0.0.1:8000
# Docker: use http://host.docker.internal:8000 for a reachable host backend,
# or the backend service name on a shared Docker network; never container loopback.
# Both values below are build-time configuration for prerendered SEO; rebuild on changes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only on the public production domain after publication review.
SEO_INDEXABLE=false
# Optional Compose host port (also update the public URLs above when changing it).
FRONTEND_PORT=3000

# Dedicated frontend database. Apply pnpm session:migrate before login is enabled.
FRONTEND_DATABASE_URL=postgresql://marketplace:marketplace@127.0.0.1:55432/marketplace_web
# Generate with: openssl rand -hex 32 (separate from NEXTAUTH_SECRET).
SESSION_VAULT_KEY=replace-with-64-random-hex-characters
