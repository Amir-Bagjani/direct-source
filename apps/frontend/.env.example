NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000
DJANGO_API_URL=http://127.0.0.1:8000
# Docker: use http://host.docker.internal:8000 for a reachable host backend,
# or the backend service name on a shared Docker network; never container loopback.
# Both values below are build-time configuration for prerendered SEO; rebuild on changes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only on the public production domain after publication review.
SEO_INDEXABLE=false
# Optional Compose host port (also update the public URLs above when changing it).
FRONTEND_PORT=3000
